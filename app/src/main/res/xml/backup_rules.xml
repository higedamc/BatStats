<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-API-31 counterpart of data_extraction_rules.xml: keep the battery history database out of
  auto backup and out of `adb backup` archives. Everything else (settings) is still backed up.
-->
<full-backup-content>
    <exclude domain="database" path="battery.db" />
    <exclude domain="database" path="battery.db-wal" />
    <exclude domain="database" path="battery.db-shm" />
    <exclude domain="database" path="battery.db-journal" />
</full-backup-content>
